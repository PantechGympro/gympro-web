{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.6",
    "framer-motion": "^12.29.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.12.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "sweetalert2": "^11.26.17",
    "vaul": "^1.1.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:ci": "react-scripts test --watchAll=false --ci --coverage",
    "lint": "eslint src --ext .js,.jsx --max-warnings=75"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/constants/**/*.js",
      "src/api/cliente.js",
      "src/pages/compartido/MembresiasPorVencer.jsx",
      "src/pages/compartido/PagosPorConfirmar.jsx",
      "!src/**/*.test.{js,jsx}"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "lines": 85,
        "functions": 80,
        "branches": 70
      }
    }
  }
}
